PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/payment_gateway
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
CHECKOUT_BASE_URL=http://localhost:5173/checkout
TRANSACTION_EXPIRY_MINUTES=30
WEBHOOK_MAX_ATTEMPTS=3

